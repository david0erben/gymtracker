rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Alter Gym Tracker (bleibt als Backup und für den Übergang unverändert)
    function isValidMainDocument() {
      return request.resource.data.keys().hasOnly([
          "version",
          "workouts",
          "bodyweight",
          "draftWorkout",
          "updatedAt"
        ])
        && request.resource.data.version == 2
        && request.resource.data.workouts is list
        && request.resource.data.bodyweight is list
        && request.resource.data.draftWorkout is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/data/main {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidMainDocument();
    }

    // Neue App: Einstellungen, laufende Trainings, Versionsinfo
    match /users/{userId}/data/{docId} {
      allow read, write: if isOwner(userId) && docId in ['settings', 'session', 'meta'];
    }

    // Neue App: ein Dokument pro Training, Körpergewicht und Cardio-Einheit
    match /users/{userId}/workouts/{id} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.id == id
        && request.resource.data.date is string
        && request.resource.data.exercises is list;
    }

    match /users/{userId}/bodyweight/{id} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.date is string
        && request.resource.data.weight is number;
    }

    match /users/{userId}/cardio/{id} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.date is string
        && request.resource.data.durationMin is number;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
